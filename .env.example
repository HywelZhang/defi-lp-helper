# ── 必填 ────────────────────────────────────────────────
# 模型 API Key（研究、AI 解读、助手对话都要用）
DEEPSEEK_API_KEY=sk-your-key-here
# 可选：兼容 OpenAI 协议的其它端点
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# LP_LLM_MODEL=deepseek-flash

# ── 登录 ────────────────────────────────────────────────
# 首次部署时用它创建账号，之后可以删掉
LP_USER=admin
LP_PASS=change-me-please

# ── 运行 ────────────────────────────────────────────────
PORT=3000
LP_CHAIN=x-layer
# LP_DB=./data/lp.db

# ── 链上执行（可选）────────────────────────────────────
# 不做真实交易可以完全不配，页面的分析、评分、计划功能都能用
# ONCHAINOS_BIN=/path/to/onchainos
